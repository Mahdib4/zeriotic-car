# Copy to .env.local and fill in. .env*.local is gitignored.

# --- Cloudflare R2 -------------------------------------------------------
# Used ONLY by scripts/upload-clips-r2.mjs. Deliberately not NEXT_PUBLIC_:
# anything with that prefix is inlined into the client bundle and shipped to
# every visitor. These must never be.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# --- Where the browser loads clips from ----------------------------------
# Optional. lib/shots.ts already defaults to the R2 bucket the clips are
# published to, so a clone or a fresh deploy works with nothing set here.
#
#   unset    -> the default R2 bucket (what production uses)
#   a URL    -> that origin, e.g. https://media.example.com (custom domain)
#   local    -> this origin's own /clips, for working offline against
#               public/clips after running compress-clips.mjs
#
# This is the only R2 value that is safe to expose publicly: it is inlined
# into the client bundle and fetched by every visitor.
NEXT_PUBLIC_CLIP_BASE_URL=
