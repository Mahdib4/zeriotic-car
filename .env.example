# Copy to .env.local and fill in. .env*.local is gitignored.

# --- Cloudflare R2 -------------------------------------------------------
# Used ONLY by scripts/upload-clips-r2.mjs. Deliberately not NEXT_PUBLIC_:
# anything with that prefix is inlined into the client bundle and shipped to
# every visitor. These must never be.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# --- Where the browser loads clips from ----------------------------------
# Empty  -> served from the app's own /clips (local development).
# Set    -> served from object storage, e.g. https://media.example.com
# This is the only R2 value that is safe to expose publicly.
NEXT_PUBLIC_CLIP_BASE_URL=
