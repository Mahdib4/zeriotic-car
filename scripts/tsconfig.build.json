{
  "//": "Compiles library sources to CommonJS so the Node scripts in this folder can read them. Inherits the root paths mapping so '@/...' imports resolve.",
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "incremental": false,
    "module": "commonjs",
    "moduleResolution": "node",
    "target": "es2022",
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "rootDir": "..",
    "outDir": "../.script-build"
  },
  "include": ["../lib/content.ts", "../lib/timeline.ts", "../lib/shots.ts", "../components/three/geometry.ts"]
}
